{
  "name": "@alpacahq/alpaca-trade-api",
  "version": "4.0.2",
  "description": "TypeScript SDK for the Alpaca Trading and Market Data APIs.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpacahq/alpaca-trade-api-js.git"
  },
  "bugs": {
    "url": "https://github.com/alpacahq/alpaca-trade-api-js/issues"
  },
  "homepage": "https://alpaca.markets/",
  "keywords": [
    "Alpaca",
    "Trading"
  ],
  "contributors": [
    "Jenya Tkachenko <jekatka@outlook.com>",
    "Aaron Suddjian <aaron@alpaca.markets>",
    "Trevor Thackston <trevor@alpaca.markets>",
    "Maksim Seliutin <maksim.seliutin@alpaca.markets>"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "rest": [
        "./dist/rest.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "workerd": {
        "types": "./dist/rest.d.mts",
        "default": "./dist/rest.mjs"
      },
      "worker": {
        "types": "./dist/rest.d.mts",
        "default": "./dist/rest.mjs"
      },
      "edge-light": {
        "types": "./dist/rest.d.mts",
        "default": "./dist/rest.mjs"
      },
      "deno": {
        "types": "./dist/rest.d.mts",
        "default": "./dist/rest.mjs"
      },
      "browser": {
        "import": {
          "types": "./dist/rest.d.mts",
          "default": "./dist/rest.mjs"
        },
        "require": {
          "types": "./dist/rest.d.ts",
          "default": "./dist/rest.js"
        }
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./rest": {
      "import": {
        "types": "./dist/rest.d.mts",
        "default": "./dist/rest.mjs"
      },
      "require": {
        "types": "./dist/rest.d.ts",
        "default": "./dist/rest.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "LICENSE",
    "MIGRATION.md",
    "codemods/README.md",
    "codemods/alpaca-v3-to-v4.js"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && npm run typecheck:examples",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "test": "vitest run",
    "verify:codemod": "vitest run codemods/alpaca-v3-to-v4.test.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "docs:api": "tsx scripts/gen-api-reference.ts",
    "docs:api-site": "tsx scripts/gen-docs-api-reference.ts",
    "docs:examples-site": "tsx scripts/gen-docs-examples.ts",
    "docs:migration-site": "tsx scripts/gen-docs-migration.ts",
    "generate": "npm --prefix tooling run generate --",
    "generate:offline": "npm --prefix tooling run generate -- --offline",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "lossless-json": "^4.3.0",
    "ws": "^8.21.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@microsoft/api-extractor": "^7.58.9",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "jscodeshift": "17.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
